<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FRIENDS / ADMIN</title>
  </head>

  <body>
    <main>
  <p class="eyebrow">FRIENDS / 03</p>

  <h1>友情链接</h1>

  <section class="form">
    <input type="text" placeholder="NAME" />
    <input type="text" placeholder="URL" />
    <input type="text" placeholder="DESCRIPTION" />
    <button>ADD FRIEND ↗</button>
  </section>

  <section class="friends">
    <h2>当前友链</h2>

    <div id="friends-list">
      <p>正在加载……</p>
    </div>
  </section>
</main>
  </body>
</html>
<script>
  const button = document.querySelector("button");
  const inputs = document.querySelectorAll("input");
  const list = document.querySelector("#friends-list");

  async function loadFriends() {
    try {
      const response = await fetch("/api/friends");
      const friends = await response.json();

      if (!friends.length) {
        list.innerHTML = "<p>暂时还没有友链。</p>";
        return;
      }

      list.innerHTML = friends.map((friend, index) => `
        <div class="friend-item">
          <div>
            <strong>${friend.name}</strong>
            <p>${friend.url}</p>
            <span>${friend.description || ""}</span>
          </div>
          <button class="delete" data-index="${index}">DELETE</button>
        </div>
      `).join("");

      document.querySelectorAll(".delete").forEach((deleteButton) => {
        deleteButton.addEventListener("click", async () => {
          const index = deleteButton.dataset.index;

          if (!confirm("确定要删除这个友链吗？")) {
            return;
          }

          const response = await fetch("/api/friends/delete", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ index }),
          });

          const result = await response.json();

          if (result.success) {
            alert("友链已删除！");
            loadFriends();
          } else {
            alert(result.message || "删除失败。");
          }
        });
      });
    } catch (error) {
      console.error(error);
      list.innerHTML = "<p>读取友链失败。</p>";
    }
  }

  button.addEventListener("click", async () => {
    const name = inputs[0].value.trim();
    const url = inputs[1].value.trim();
    const description = inputs[2].value.trim();

    if (!name || !url) {
      alert("请填写名字和 URL。");
      return;
    }

    try {
      const response = await fetch("/api/friends", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          name,
          url,
          description,
        }),
      });

      const result = await response.json();

      if (result.success) {
        alert("友链添加成功！");
        inputs.forEach((input) => {
          input.value = "";
        });
        loadFriends();
      } else {
        alert(result.message || "添加失败。");
      }
    } catch (error) {
      console.error(error);
      alert("添加失败，请检查 Admin 服务是否正常运行。");
    }
  });

  loadFriends();
</script>

