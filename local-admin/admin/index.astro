---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ADMIN / AKISOU</title>
  </head>

  <body>
    <main>
      <header>
        <a href="/" class="logo">AKISOU'S BLOG</a>
        <span>ADMIN</span>
      </header>

      <section class="hero">
        <p class="number">ADMIN / 01</p>

        <h1>BLOG<br />MANAGEMENT</h1>

        <p class="description">
          管理你的日常、旅行和字幕文章。
        </p>
      </section>

      <section class="menu">
        <a href="/admin/new" class="menu-item">
          <div>
            <span class="menu-number">01</span>
            <h2>NEW POST</h2>
            <p>写一篇新的文章</p>
          </div>
          <span class="arrow">↗</span>
        </a>

        <a href="/admin/posts" class="menu-item">
          <div>
            <span class="menu-number">02</span>
            <h2>MANAGE POSTS</h2>
            <p>编辑、删除已有文章</p>
          </div>
          <span class="arrow">↗</span>
        </a>
      </section>

      <footer>
        <span>AKISOU'S BLOG</span>
        <a href="/akisou-blog/" target="_blank">VIEW BLOG ↗</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 55px 30px 40px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #35495E;
    font-family: monospace;
    font-size: 13px;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: 0.05em;
  }

  .hero {
    padding: 90px 0 70px;
  }

  .number,
  .menu-number {
    color: #7CB1D2;
    font-family: monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 28px 0 22px;
    font-size: clamp(52px, 9vw, 88px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .description {
    color: #667B7F;
    font-size: 16px;
  }

  .menu {
    border-top: 1px solid #FFA62B;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 8px;
    border-bottom: 1px solid #FFA62B;
    color: #35495E;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .menu-item:hover {
    padding-left: 18px;
    padding-right: 18px;
    background: #FFA62B;
  }

  h2 {
    margin: 8px 0 6px;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .menu-item p {
    margin: 0;
    color: #849A98;
    font-size: 14px;
  }

  .arrow {
    font-size: 28px;
    color: #7CB1D2;
  }

  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 70px;
    padding-top: 20px;
    border-top: 1px solid #FFA62B;
    color: #849A98;
    font-family: monospace;
    font-size: 12px;
  }

  footer a {
    color: #7CB1D2;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    main {
      padding: 30px 20px;
    }

    .hero {
      padding: 70px 0 50px;
    }

    h1 {
      font-size: 54px;
    }
  }
</style>
