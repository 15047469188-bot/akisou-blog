---
const { title, date, description } = Astro.props;

const path = Astro.url.pathname;

const category =
  path.startsWith("/akisou-blog/travel/")
    ? "TRAVEL"
    : path.startsWith("/akisou-blog/subtitles/")
      ? "SUBTITLES"
      : path.startsWith("/akisou-blog/works/")
        ? "WORKS"
        : "DAILY LIFE";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} / AKISOU</title>
  </head>

  <body>
    <main class="page">

      <header>
        <a href="/akisou-blog/" class="logo">AKISOU'S BLOG</a>

        <nav>
          <a href="/akisou-blog/">HOME</a>
          <a href="/akisou-blog/about/">ABOUT</a>
        </nav>
      </header>

      <article>

        <div class="meta">
          <span>{category}</span>
          <span>{date}</span>
        </div>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        <div class="line"></div>

        <div class="content">
          <slot />
        </div>

        <section class="comments" aria-label="评论区">
          <script
            src="https://giscus.app/client.js"
            data-repo="akisou-blog/akisou-blog"
            data-repo-id="R_kgDOU5pq2A"
            data-category="Announcements"
            data-category-id="DIC_kwDOU5pq2M4DHGGA"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="light"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </section>

      </article>

      <a
        href={
          category === "TRAVEL"
            ? "/akisou-blog/travel/"
            : category === "SUBTITLES"
              ? "/akisou-blog/subtitles/"
              : category === "WORKS"
                ? "/akisou-blog/works/"
                : "/akisou-blog/daily/"
        }
        class="back"
      >
        ← BACK TO {
          category === "TRAVEL"
            ? "TRAVEL"
            : category === "SUBTITLES"
              ? "SUBTITLES"
              : category === "WORKS"
                ? "WORKS"
                : "DAILY"
        }
      </a>

      <footer>
        <span>AKISOU'S BLOG</span>
        <span>2026 — NOW</span>
      </footer>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 55px 30px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #35495E;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
    transition: color 0.25s ease;
  }

  .logo:hover {
    color: #7CB1D2;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  nav a:hover,
  .back:hover {
    color: #7CB1D2;
  }

  article {
    padding: 100px 0 50px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 13px;
  }

  h1 {
    margin: 35px 0 25px;
    color: #35495E;
    font-size: clamp(48px, 8vw, 82px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .description {
    margin: 0;
    color: #849A98;
    font-size: 16px;
    line-height: 1.8;
  }

  .line {
    margin: 55px 0;
    border-top: 1px solid #FFA62B;
  }

  .content {
    max-width: 700px;
    color: #35495E;
    font-size: 17px;
    line-height: 2;
  }

  .content :global(h1) {
    color: #35495E;
    font-size: 32px;
    margin: 0 0 30px;
  }

  .content :global(h2) {
    margin: 60px 0 20px;
    padding-left: 15px;
    border-left: 3px solid #7CB1D2;
    color: #35495E;
    font-size: 26px;
    line-height: 1.4;
    font-weight: 500;
  }

  .content :global(p) {
    margin: 0 0 28px;
  }

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 40px 0;
  }

  .content :global(figure) {
    margin: 40px 0;
  }

  .content :global(figcaption) {
    margin-top: -25px;
    margin-bottom: 40px;
    color: #849A98;
    font-family: monospace;
    font-size: 12px;
    line-height: 1.6;
  }

  .content :global(.caption) {
    display: block !important;
    margin: -25px 0 40px !important;
    color: #849A98 !important;
    font-family: monospace !important;
    font-size: 12px !important;
    line-height: 1.6 !important;
  }

  .content :global(strong) {
    color: #35495E;
    font-weight: 600;
  }

  .back {
    display: inline-block;
    margin-top: 60px;
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 100px;
    padding-top: 20px;
    border-top: 1px solid #35495E;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  @media (max-width: 700px) {
    .page {
      padding: 30px 20px;
    }

    header {
      align-items: flex-start;
    }

    nav {
      gap: 15px;
    }

    article {
      padding: 75px 0 30px;
    }

    .meta {
      font-size: 11px;
    }

    .content {
      font-size: 16px;
      line-height: 1.9;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }


  /* code blocks */
  :global(pre.astro-code) {
    margin: 28px 0;
    padding: 18px 20px;
    overflow-x: auto;
    background: #F7FBFD !important;
    border: 1px solid #CFE3EF;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(124, 177, 210, 0.08);
    font-size: 13px;
    line-height: 1.9;
  }

  :global(pre.astro-code code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  :global(:not(pre) > code) {
    padding: 3px 7px;
    background: #F7FBFD;
    border: 1px solid #CFE3EF;
    border-radius: 6px;
    color: #7CB1D2;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.9em;
  }

</style>
