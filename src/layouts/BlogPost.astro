---
const { title, date, description } = Astro.props;

const path = Astro.url.pathname;

const category =
  path.startsWith("/akisou-blog/travel/")
    ? "TRAVEL"
    : path.startsWith("/akisou-blog/subtitles/")
      ? "SUBTITLES"
      : "DAILY LIFE";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} / AKISOU</title>
  </head>

  <body>
    <main class="page">

      <header>
        <a href="/akisou-blog/" class="logo">AKISOU'S BLOG</a>

        <nav>
          <a href="/akisou-blog/">HOME</a>
          <a href="/akisou-blog/about/">ABOUT</a>
        </nav>
      </header>

      <article>

        <div class="meta">
          <span>{category}</span>
          <span>{date}</span>
        </div>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        <div class="line"></div>

        <div class="content">
          <slot />
        </div>

      </article>

      <a
        href={
          category === "TRAVEL"
            ? "/akisou-blog/travel/"
            : category === "SUBTITLES"
              ? "/akisou-blog/subtitles/"
              : "/akisou-blog/daily/"
        }
        class="back"
      >
        ← BACK TO {
          category === "TRAVEL"
            ? "TRAVEL"
            : category === "SUBTITLES"
              ? "SUBTITLES"
              : "DAILY"
        }
      </a>

      <footer>
        <span>AKISOU'S BLOG</span>
        <span>2026 — NOW</span>
      </footer>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f5f9fe;
    color: #203b57;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 55px 30px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #203b57;
  }

  .logo {
    color: #203b57;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
    transition: color 0.25s ease;
  }

  .logo:hover {
    color: #4a90d9;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #203b57;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  nav a:hover,
  .back:hover {
    color: #4a90d9;
  }

  article {
    padding: 100px 0 50px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    color: #4a90d9;
    font-family: monospace;
    font-size: 13px;
  }

  h1 {
    margin: 35px 0 25px;
    color: #203b57;
    font-size: clamp(48px, 8vw, 82px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .description {
    margin: 0;
    color: #71859a;
    font-size: 16px;
    line-height: 1.8;
  }

  .line {
    margin: 55px 0;
    border-top: 1px solid #c9ddf2;
  }

  .content {
    max-width: 700px;
    color: #29445f;
    font-size: 17px;
    line-height: 2;
  }

  .content :global(h1) {
    color: #203b57;
    font-size: 32px;
    margin: 0 0 30px;
  }

  .content :global(h2) {
    margin: 60px 0 20px;
    padding-left: 15px;
    border-left: 3px solid #5aa7e8;
    color: #28557d;
    font-size: 26px;
    line-height: 1.4;
    font-weight: 500;
  }

  .content :global(p) {
    margin: 0 0 28px;
  }

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 40px 0;
  }

  .content :global(figure) {
    margin: 40px 0;
  }

  .content :global(figcaption) {
    margin-top: -25px;
    margin-bottom: 40px;
    color: #71859a;
    font-family: monospace;
    font-size: 12px;
    line-height: 1.6;
  }

  .content :global(.caption) {
    display: block !important;
    margin: -25px 0 40px !important;
    color: #71859a !important;
    font-family: monospace !important;
    font-size: 12px !important;
    line-height: 1.6 !important;
  }

  .content :global(strong) {
    color: #28557d;
    font-weight: 600;
  }

  .back {
    display: inline-block;
    margin-top: 60px;
    color: #203b57;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 100px;
    padding-top: 20px;
    border-top: 1px solid #203b57;
    font-family: monospace;
    font-size: 12px;
    color: #71859a;
  }

  @media (max-width: 700px) {
    .page {
      padding: 30px 20px;
    }

    header {
      align-items: flex-start;
    }

    nav {
      gap: 15px;
    }

    article {
      padding: 75px 0 30px;
    }

    .meta {
      font-size: 11px;
    }

    .content {
      font-size: 16px;
      line-height: 1.9;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>
