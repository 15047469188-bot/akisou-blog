---
const photos = [
  {
    title: "OSAKA",
    date: "2026.06",
    image: "/photos/osaka.jpg",
  },
  {
    title: "KYOTO",
    date: "2026.06",
    image: "/photos/kyoto.jpg",
  },
  {
    title: "TOKYO",
    date: "2026",
    image: "/photos/tokyo.jpg",
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GALLERY / BINYAN</title>
  </head>

  <body>
    <main class="page">
      <header>
        <a class="logo" href="/akisou-blog/">
          <strong>BINYAN</strong>
          <span>田彬颜 / BLOG</span>
        </a>

        <nav>
          <a href="/akisou-blog/">BLOG</a>
          <a href="/gallery">GALLERY</a>
          <a href="/akisou-blog/about/">ABOUT</a>
        </nav>
      </header>

      <section class="intro">
        <p>GALLERY / 02</p>
        <h1>
          Some places,<br />
          <span>some memories.</span>
        </h1>
      </section>

      <section class="gallery">
        {photos.map((photo, index) => (
          <article class={`photo photo-${index + 1}`}>
            <div class="image">
              <img src={photo.image} alt={photo.title} />
            </div>

            <div class="caption">
              <span>{photo.date}</span>
              <strong>{photo.title}</strong>
            </div>
          </article>
        ))}
      </section>

      <a class="back" href="/akisou-blog/">← BACK TO BLOG</a>

      <footer>
        <span>BINYAN / BLOG</span>
        <span>2026 — now</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #24415F;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", sans-serif;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 70px 32px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid #24415F;
    padding-bottom: 28px;
    margin-bottom: 90px;
  }

  .logo {
    text-decoration: none;
    color: #24415F;
  }

  .logo strong {
    display: block;
    font-family: monospace;
    font-size: 32px;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .logo span {
    display: block;
    margin-top: 8px;
    color: #79D1C3;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #24415F;
    text-decoration: none;
    font-family: monospace;
  }

  nav a:hover,
  .back:hover {
    color: #79D1C3;
  }

  .intro {
    margin-bottom: 80px;
  }

  .intro p {
    margin: 0 0 30px;
    font-family: monospace;
    color: #79D1C3;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(50px, 8vw, 88px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .intro h1 span {
    color: #79D1C3;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 70px 35px;
  }

  .photo-2 {
    margin-top: 120px;
  }

  .photo-3 {
    grid-column: 1 / -1;
    width: 70%;
    margin: 0 auto;
  }

  .image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #dfe3e5;
  }

  .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .photo:hover img {
    transform: scale(1.03);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    font-family: monospace;
  }

  .caption span {
    color: #5F7185;
  }

  .caption strong {
    font-weight: 400;
  }

  .back {
    display: inline-block;
    margin-top: 100px;
    color: #24415F;
    text-decoration: none;
    font-family: monospace;
  }

  footer {
    margin-top: 100px;
    padding-top: 25px;
    border-top: 1px solid #24415F;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 13px;
  }

  @media (max-width: 700px) {
    .page {
      padding: 35px 20px;
    }

    header {
      display: block;
      margin-bottom: 60px;
    }

    nav {
      margin-top: 25px;
    }

    .gallery {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .photo-2 {
      margin-top: 0;
    }

    .photo-3 {
      width: 100%;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>
