<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", sans-serif;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 70px 32px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid #35495E;
    padding-bottom: 28px;
    margin-bottom: 90px;
  }

  .logo {
    text-decoration: none;
    color: #35495E;
  }

  .logo strong {
    display: block;
    font-family: monospace;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  nav {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
  }

  nav a:hover,
  .back:hover {
    color: #7CB1D2;
  }

  .about {
    max-width: 850px;
  }

  .label {
    margin: 0 0 35px;
    font-family: monospace;
    font-size: 12px;
    color: #7CB1D2;
  }

  h1 {
    margin: 0;
    font-size: clamp(50px, 8vw, 90px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  h1 span {
    color: #7CB1D2;
  }

  .text {
    margin-top: 70px;
    margin-left: 35%;
    font-size: 18px;
    line-height: 2;
    color: #667B7F;
  }

  .text p {
    margin: 0 0 28px;
  }

  .text .small {
    margin-top: 60px;
    font-family: monospace;
    font-size: 13px;
    color: #35495E;
  }

  .contact {
    margin-top: 80px;
  }

  .contact a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  .contact a:hover {
    color: #7CB1D2;
  }

  .contact-links {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 128px;
    height: 46px;
    padding: 0 18px;
    border: 1.5px solid #D6E8EF;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    color: #35495E;
    text-decoration: none;
    box-sizing: border-box;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .contact-item:hover {
    transform: translateY(-3px);
    background: #FFFFFF;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
  }

  .contact-icon svg {
    width: 25px;
    height: 25px;
    display: block;
  }

  .contact-name {
    font-family: monospace;
    font-size: 13px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: inherit;
  }

  .contact-item:has(.xhs-icon) .contact-name {
    color: #E9899F;
  }

  .contact-item:has(.bili-icon) .contact-name {
    color: #69BBD8;
  }

  .contact-item:has(.x-icon) .contact-name {
    color: #657894;
  }

  .contact-item:has(.wechat-icon) .contact-name {
    color: #72B886;
  }

  .contact-item:has(.rss-icon) .contact-name {
    color: #E7A34D;
  }

  .xhs-icon {
    color: #E9899F;
  }

  .bili-icon {
    color: #69BBD8;
  }

  .x-icon {
    color: #657894;
  }

  .wechat-icon {
    color: #72B886;
  }

  .rss-icon {
    color: #E7A34D;
  }

  .contact-item:has(.xhs-icon) {
    border-color: #E9B4C0;
  }

  .contact-item:has(.bili-icon) {
    border-color: #A8D9E9;
  }

  .contact-item:has(.x-icon) {
    border-color: #AAB6C8;
  }

  .contact-item:has(.wechat-icon) {
    border-color: #ABD6B5;
  }

  .contact-item:has(.rss-icon) {
    border-color: #EBC98F;
  }

  .wechat-item {
    cursor: pointer;
    font: inherit;
  }

  .back {
    display: inline-block;
    margin-top: 90px;
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
  }

  footer {
    margin-top: 100px;
    padding-top: 25px;
    border-top: 1px solid #35495E;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  @media (max-width: 700px) {
    .page {
      padding: 35px 20px;
    }

    header {
      display: block;
      margin-bottom: 60px;
    }

    nav {
      margin-top: 25px;
      gap: 16px;
    }

    .about {
      max-width: none;
    }

    .text {
      margin-left: 0;
      margin-top: 50px;
      font-size: 16px;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>
