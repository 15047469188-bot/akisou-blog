---
const dailyPosts = Object.values(
  import.meta.glob("./daily/posts/*.md", { eager: true })
);
const categories = [
  {
    name: "日常",
    english: "DAILY LIFE",
    description: "一些普通但想留下来的日子。",
    url: "/daily",
  },
  {
    name: "旅行",
    english: "TRAVEL",
    description: "去过的地方，以及路上的一些记录。",
    url: "/travel",
  },
  {
    name: "字幕",
    english: "SUBTITLES",
    description: "关于字幕、日语和喜欢的作品。",
    url: "/subtitles",
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AKISOU'S BLOG</title>
  </head>

  <body>
    <main class="page">

      <!-- 顶部 -->
      <header>
        <a href="/" class="logo">AKISOU'S BLOG</a>

        <nav>
          <a href="/">HOME</a>
          <a href="/about">ABOUT</a>
        </nav>
      </header>

      <!-- 首页介绍 -->
      <section class="intro">
        <p class="hello">HELLO, I'M AKISOU.</p>

        <h1>
          记录一些<br />
          <span>喜欢的东西。</span>
        </h1>

        <p class="description">
          字幕 / 旅行 / 日常
        </p>
      </section>

      <!-- 分类 -->
      <section class="latest">

  <div class="section-title">
    <span>LATEST</span>
    <span>{dailyPosts.length.toString().padStart(2, "0")}</span>
  </div>

  {dailyPosts.map((post) => (
    <a href={post.url} class="latest-post">
      <div class="latest-date">
        {post.frontmatter.date}
      </div>

      <div class="latest-main">
        <h2>{post.frontmatter.title}</h2>
        <p>{post.frontmatter.description}</p>
      </div>

      <div class="latest-arrow">↗</div>
    </a>
  ))}

</section>
      <section class="categories">

        <div class="section-title">
          <span>EXPLORE</span>
          <span>01 — 03</span>
        </div>

        {categories.map((category, index) => (
          <a href={category.url} class="category">
            <div class="number">
              0{index + 1}
            </div>

            <div class="category-main">
              <h2>{category.name}</h2>
              <p>{category.description}</p>
            </div>

            <div class="english">
              {category.english}
            </div>

            <div class="arrow">
              ↗
            </div>
          </a>
        ))}

      </section>

      <!-- 底部 -->
      <footer>
        <span>AKISOU'S BLOG</span>
        <span>2026 — NOW</span>
      </footer>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f8f6;
    color: #172536;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    max-width: 1050px;
    margin: 0 auto;
    padding: 55px 30px;
  }

  /* 顶部 */

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #172536;
  }

  .logo {
    color: #172536;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #172536;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  nav a:hover {
    color: #e87532;
  }

  /* 首页介绍 */

  .intro {
    padding: 110px 0 130px;
  }

  .hello {
    margin: 0 0 28px;
    color: #e87532;
    font-family: monospace;
    font-size: 13px;
  }

  h1 {
    margin: 0;
    font-size: clamp(52px, 9vw, 100px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  h1 span {
    color: #e87532;
  }

  .description {
    margin: 45px 0 0;
    color: #52606d;
    font-size: 18px;
    letter-spacing: 0.08em;
  }

/* 最新文章 */

.latest {
  margin-bottom: 100px;
}

.latest-post {
  display: grid;
  grid-template-columns: 150px 1fr 30px;
  gap: 30px;
  align-items: center;

  padding: 35px 0;

  color: #172536;
  text-decoration: none;

  border-bottom: 1px solid #ccd2d6;

  transition: all 0.25s ease;
}

.latest-post:hover {
  color: #e87532;
  padding-left: 10px;
}

.latest-date {
  font-family: monospace;
  color: #697681;
  font-size: 13px;
}

.latest-main h2 {
  margin: 0 0 10px;
  font-size: 25px;
  font-weight: 500;
}

.latest-main p {
  margin: 0;
  color: #697681;
  font-size: 14px;
}

.latest-arrow {
  font-size: 22px;
}
  /* 分类 */

  .section-title {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 1px solid #172536;
    border-bottom: 1px solid #ccd2d6;
    font-family: monospace;
    font-size: 13px;
  }

  .section-title span:last-child {
    color: #e87532;
  }

  .category {
    display: grid;
    grid-template-columns: 70px 1fr 180px 30px;
    align-items: center;
    gap: 25px;

    padding: 38px 0;

    color: #172536;
    text-decoration: none;

    border-bottom: 1px solid #ccd2d6;

    transition: all 0.25s ease;
  }

  .category:hover {
    color: #e87532;
    padding-left: 10px;
  }

  .number {
    font-family: monospace;
    color: #697681;
  }

  font-size: 38px;.category-main h2 {
    margin: 0 0 10px;
    font-size: 34px;
    font-weight: 500;
  }

  .category-main p {
    margin: 0;
    color: #697681;
    font-size: 14px;
  }

  .english {
    font-family: monospace;
    font-size: 12px;
    color: #697681;
  }

  .arrow {
    font-size: 22px;
  }

  /* 底部 */

  footer {
    display: flex;
    justify-content: space-between;

    margin-top: 100px;
    padding-top: 20px;

    border-top: 1px solid #172536;

    font-family: monospace;
    font-size: 12px;
  }

  /* 手机 */

  @media (max-width: 700px) {

.latest-post {
  grid-template-columns: 1fr 25px;
  gap: 10px;
}

.latest-date {
  grid-column: 1 / -1;
}
    .page {
      padding: 30px 20px;
    }

    header {
      align-items: flex-start;
    }

    nav {
      gap: 15px;
    }

    .intro {
      padding: 80px 0 90px;
    }

    .category {
      grid-template-columns: 40px 1fr 25px;
      gap: 15px;
      padding: 30px 0;
    }

    .english {
      display: none;
    }

    .category-main h2 {
      font-size: 28px;
    }

    .category-main p {
      font-size: 13px;
      line-height: 1.7;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>
