---
import Sidebar from "../components/Sidebar.astro";
import friends from "../data/friends.json";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FRIENDS / AKISOU'S BLOG</title>
</head>

<body>

  <main class="page">
    <Sidebar />

    <div class="friends-main">
      <p class="eyebrow">FRIENDS / 01</p>

    <h1>友情链接</h1>

{friends.length === 0 ? (
  <div class="empty">
    <p>这里暂时还没有友链。</p>
    <span>以后再慢慢认识新的朋友吧 ♡</span>
  </div>
) : (
  <div class="friends-list">
    {friends.map((friend) => (
      <a href={friend.url} class="friend" target="_blank" rel="noopener noreferrer">
        <div>
          <h2>{friend.name}</h2>
          <p>{friend.description}</p>
        </div>
        <span>↗</span>
      </a>
    ))}
  </div>
)}
    </div>
  </main>

</body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", "Hiragino Sans GB", sans-serif;
  }

  header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  nav a:hover {
    color: #7CB1D2;
  }

  .page {
    width: min(1400px, calc(100% - 60px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 55px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 55px;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.05em;
  }
 .friends-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.friend {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 90px;
  padding: 18px;
  border: 1px solid #CDEBE8;
  border-radius: 10px;
  color: #35495E;
  text-decoration: none;
  background: rgba(247, 252, 251, 0.72);
  box-shadow: 0 4px 18px rgba(121, 201, 195, 0.08);
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.friend:hover {
  transform: translateY(-3px);
  border-color: #79C9C3;
  background: rgba(241, 250, 248, 0.82);
}

.friend h2 {
  margin: 0 0 8px;
  font-size: 20px;
  font-weight: 500;
}

.friend p {
  margin: 0;
  color: #71808C;
  font-size: 14px;
}

.friend > span {
  color: #FFA62B;
  font-size: 20px;
}

.friend:hover h2 {
  color: #7CB1D2;
}

  .empty {
    padding: 55px 10px;
    border-top: 1px solid #D6E8EF;
    border-bottom: 1px solid #D6E8EF;
  }

  .empty p {
    margin: 0 0 12px;
    font-size: 18px;
    color: #35495E;
  }

  .empty span {
    color: #71808C;
    font-size: 14px;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 30px 0;
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .friends-list {
      grid-template-columns: 1fr;
    }
  }
</style>
