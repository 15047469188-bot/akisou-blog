---
import PageLoader from "../components/PageLoader.astro";
import FloatingTanghulu from "../components/FloatingTanghulu.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>404 / IZUMI'S BLOG</title>
  </head>

  <body>
    <PageLoader />
    <FloatingTanghulu />
    <main class="page">
      <header>
        <a href="/" class="logo">IZUMI'S BLOG</a>

        <span class="label">404</span>
      </header>

      <section>
        <p class="number">ERROR / 404</p>

        <h1>
          这里什么也没有。
        </h1>

        <p class="text">
          你访问的页面可能已经被删除，<br />
          或者根本没有存在过。
        </p>

        <a href="/" class="back">← BACK TO BLOG</a>
      </section>

      <footer class="site-footer">
        <p>This blog is live for <span id="blog-live-time">0 days, 0 hours, 0 mins</span> and counting.</p>
        <p>Copyright © 2026 IZUMI · 糖葫芦</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
      "PingFang SC", sans-serif;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 70px 32px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid #35495E;
    padding-bottom: 28px;
    margin-bottom: 120px;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .label,
  .number {
    font-family: monospace;
    font-size: 12px;
  }

  .label {
    color: #667B7F;
  }

  .number {
    margin: 0 0 30px;
    color: #F8E6A0;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .text {
    margin-top: 40px;
    color: #667B7F;
    font-size: 16px;
    line-height: 2;
  }

  .back {
    display: inline-block;
    margin-top: 60px;
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
  }

  .back:hover {
    color: #F8E6A0;
  }

  footer {
    margin-top: auto;
    padding-top: 25px;
    border-top: 1px solid #35495E;
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .page {
      padding: 35px 20px;
    }

    header {
      margin-bottom: 80px;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>

<script>
  const blogStart = new Date("2026-10-03T00:00:00+08:00");
  const liveTime = document.querySelector("#blog-live-time");

  function updateBlogLiveTime() {
    if (!liveTime) return;

    const diff = Date.now() - blogStart.getTime();
    const totalMinutes = Math.floor(diff / 60000);

    const days = Math.floor(totalMinutes / 1440);
    const hours = Math.floor((totalMinutes % 1440) / 60);
    const minutes = totalMinutes % 60;

    liveTime.textContent = `${days} days, ${hours} hours, ${minutes} mins`;
  }

  updateBlogLiveTime();
  setInterval(updateBlogLiveTime, 60000);
</script>
