---
import Sidebar from "../../components/Sidebar.astro";

const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/akisou-blog/images/favicon.png" />
    <title>WORKS / AKISOU'S BLOG</title>
  </head>

  <body>
    <main class="page">
      <Sidebar />

      <div class="works-main">
        <section class="hero">
        <p class="number">WORKS / 04</p>

        <h1>书影音游</h1>

        <p class="description">
          喜欢什么就往这里丢。
        </p>
      </section>

      <section class="posts">
        {posts.length === 0 ? (
          <p class="empty">还没有东西可以丢进来。</p>
        ) : (
          posts
            .sort((a, b) =>
              b.frontmatter.date.localeCompare(a.frontmatter.date)
            )
            .map((post) => (
              <a href={post.url} class="post">
                <div class="date">
                  {post.frontmatter.date}
                </div>

                <div class="main">
                  <h2>{post.frontmatter.title}</h2>
                  <p>{post.frontmatter.description}</p>
                </div>

                <div class="arrow">↗</div>
              </a>
            ))
        )}
      </section>

        <footer>
          <span>WORKS</span>
        </footer>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    width: min(1400px, calc(100% - 60px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 55px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #35495E;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
  }

  .hero {
    padding: 45px 0 55px;
  }

  .number {
    margin: 0 0 25px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 13px;
  }

  h1 {
    margin: 0;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .description {
    margin-top: 35px;
    color: #667B7F;
    font-size: 16px;
  }

  .section-title {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 1px solid #35495E;
    border-bottom: 1px solid #CFE3EF;
    font-family: monospace;
    font-size: 13px;
  }

  .section-title span:last-child {
    color: #7CB1D2;
  }

  .post {
    display: grid;
    grid-template-columns: 150px 1fr 30px;
    gap: 30px;
    align-items: center;
    padding: 24px 22px;
    margin-bottom: 12px;
    color: #35495E;
    text-decoration: none;
    border: 1px solid #CDEBE8;
    border-radius: 10px;
    background: rgba(247, 252, 251, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 18px rgba(121, 201, 195, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .post:hover {
    color: #7CB1D2;
    transform: translate(-8px, -2px);
    border-color: #79C9C3;
    background: rgba(241, 250, 248, 0.82);
  }

  .date {
    color: #849A98;
    font-family: monospace;
    font-size: 13px;
  }

  .main h2 {
    margin: 0 0 10px;
    font-size: 25px;
    font-weight: 500;
  }

  .main p {
    margin: 0;
    color: #849A98;
    font-size: 14px;
  }

  .arrow {
    color: #7CB1D2;
    font-size: 22px;
  }

  .empty {
    padding: 45px 0;
    color: #849A98;
  }

  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 100px;
    padding-top: 20px;
    border-top: 1px solid #35495E;
    color: #849A98;
    font-family: monospace;
    font-size: 12px;
  }

  footer a {
    color: #7CB1D2;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    main {
      padding: 30px 20px;
    }

    .hero {
      padding: 75px 0 65px;
    }

    .post {
      grid-template-columns: 1fr 25px;
      gap: 10px;
    }

    .date {
      grid-column: 1 / -1;
    }

    .main h2 {
      font-size: 21px;
    }
  }
</style>
