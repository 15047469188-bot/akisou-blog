---
const postFiles = import.meta.glob("./{daily,travel,subtitles,works}/posts/*.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

const postModules = import.meta.glob("./{daily,travel,subtitles,works}/posts/*.md", {
  eager: true,
});

const posts = Object.entries(postModules)
  .map(([path, post]) => {
    const raw = postFiles[path] || "";

    const body = raw.replace(/^---[\s\S]*?---/, "").replace(/\s/g, "");

    return {
      ...post,
      wordCount: Array.from(body).length,
    };
  })
  .sort((a, b) =>
    b.frontmatter.date.localeCompare(a.frontmatter.date)
  );

const categories = [
  {
    name: "碎碎念",
    english: "DAILY LIFE",
    description: "没什么大事，胡思乱想先放这里。",
    url: `${import.meta.env.BASE_URL}/daily/`,
  },
  {
    name: "到处乱跑",
    english: "TRAVEL",
    description: "先出门再说。",
    url: `${import.meta.env.BASE_URL}/travel/`,
  },
  {
    name: "听写小作坊",
    english: "SUBTITLES",
    description: "偶尔也怀疑自己的耳朵。",
    url: `${import.meta.env.BASE_URL}/subtitles/`,
  },
  {
    name: "书影音游",
    english: "WORKS",
    description: "喜欢什么就往这里丢。",
    url: `${import.meta.env.BASE_URL}/works/`,
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/akisou-blog/images/favicon.png" />
    <title>AKISOU'S BLOG</title>
  </head>

  <body>
    <main class="page">

      <!-- 顶部 -->
      <header>
        <a href={import.meta.env.BASE_URL} class="logo">
          AKISOU'S BLOG
        </a>

        <nav>
          <a href={import.meta.env.BASE_URL}>HOME</a>
          <a href={`${import.meta.env.BASE_URL}/about`}>ABOUT</a>
          <a href={`${import.meta.env.BASE_URL}/friends`}>FRIENDS</a>
        </nav>
      </header>

      <!-- 首页介绍 -->
      <section class="intro">
        <img
          class="avatar"
          src={`${import.meta.env.BASE_URL}/images/akisou-tanghulu.png`}
          alt="糖葫芦头像"
        />

        <p class="hello">HELLO, I'M AKISOU.</p>

        <h1>
          好きなもの、<br />
          <span>好きな時間。</span>
        </h1>

        <p class="description">
          日々 / 旅 / ことば / 好きなもの
        </p>
      </section>

      <!-- 最新文章 -->
      <section class="latest">

        <div class="section-title">
          <span>LATEST</span>
          <span>{posts.length.toString().padStart(2, "0")}</span>
        </div>

        <div class="latest-grid">
          {posts.slice(0, 6).map((post) => (
            <a href={`${post.url}`} class="latest-post">
              <div class="latest-card-top">
                <span>
                  {post.frontmatter.date} · {post.wordCount.toLocaleString()} 字
                </span>
                <span>↗</span>
              </div>

              <div class="latest-main">
                <h2>{post.frontmatter.title}</h2>
                <p>{post.frontmatter.description}</p>
              </div>

              <div class="latest-card-bottom">
                <span>{
  ({
    "日常": "碎碎念",
    "旅行": "到处乱跑",
    "字幕": "听写小作坊",
    "作品分享": "书影音游",
  }[post.frontmatter.category] || post.frontmatter.category || "BLOG")
}</span>
              </div>
            </a>
          ))}
        </div>

        {posts.length > 6 && (
          <a href={`${import.meta.env.BASE_URL}/archive/`} class="view-all">
            VIEW ALL <span>↗</span>
          </a>
        )}

      </section>

      <!-- 分类 -->
      <section class="categories">

        <div class="section-title">
          <span>ARCHIVE</span>
          <span>01 — 04</span>
        </div>

        <div class="category-grid">
          {categories.map((category, index) => (
            <a href={category.url} class="category">

              <div class="category-top">
                <span>0{index + 1}</span>
                <span>↗</span>
              </div>

              <div class="category-main">
                <h2>{category.name}</h2>
                <p>{category.description}</p>
              </div>

              <div class="english">
                {category.english}
              </div>

            </a>
          ))}
        </div>

      </section>

      <!-- 底部 -->
      <footer>
        <span>AKISOU'S BLOG</span>
        <span>2026 — NOW</span>
      </footer>

    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F8FCFB;
    color: #35495E;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "PingFang SC",
      sans-serif;
  }

  .page {
    max-width: 1050px;
    margin: 0 auto;
    padding: 55px 30px;
  }

  /* 顶部 */

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #35495E;
  }

  .logo {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 0.05em;
    transition: color 0.25s ease;
  }

  .logo:hover {
    color: #7CB1D2;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #35495E;
    text-decoration: none;
    font-family: monospace;
    font-size: 13px;
    transition: color 0.25s ease;
  }

  nav a:hover {
    color: #7CB1D2;
  }

  /* 首页介绍 */

  .intro {
    padding: 110px 0 130px;
  }

  .avatar {
    display: block;
    width: 64px;
    height: 64px;
    margin-bottom: 22px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hello {
    margin: 0 0 28px;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
  }


  h1 {
    margin: 0;
    color: #35495E;
        font-size: clamp(42px, 7vw, 78px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  h1 span {
    color: #7CB1D2;
  }

  .description {
    margin: 45px 0 0;
    color: #667B7F;
    font-size: 18px;
    letter-spacing: 0.08em;
  }

  /* 最新文章 */

  .latest {
    margin-bottom: 100px;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .latest-post {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 22px;
    color: #35495E;
    text-decoration: none;
    border: 1px solid #CFE3EF;
    border-radius: 14px;
    background: #FFFFFF;
    box-shadow: 0 4px 14px rgba(124, 177, 210, 0.06);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .latest-post:hover {
    color: #35495E;
    transform: translateY(-5px);
    border-color: #7CB1D2;
    box-shadow: 0 10px 24px rgba(124, 177, 210, 0.12);
  }

  .latest-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid #E5F0F4;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  .latest-card-top span:last-child {
    color: #7CB1D2;
    font-size: 18px;
  }

  .latest-main {
    flex: 1;
    padding: 30px 0;
  }

  .latest-main h2 {
    margin: 0 0 14px;
    color: #35495E;
    font-size: 22px;
    line-height: 1.5;
    font-weight: 500;
  }

  .latest-main p {
    margin: 0;
    color: #849A98;
    font-size: 13px;
    line-height: 1.8;
  }

  .latest-card-bottom {
    padding-top: 14px;
    border-top: 1px solid #E5F0F4;
    color: #7CB1D2;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .view-all {
    display: block;
    width: fit-content;
    margin: 24px 0 0 auto;
    padding: 10px 2px;
    color: #7CB1D2;
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #CFE3EF;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .view-all span {
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.2s ease;
  }

  .view-all:hover {
    color: #35495E;
    border-color: #7CB1D2;
    transform: translateX(3px);
  }

  .view-all:hover span {
    transform: translate(2px, -2px);
  }

  /* 分类 */

  .section-title {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;

    border-top: 1px solid #35495E;
    border-bottom: 1px solid #CFE3EF;

    font-family: monospace;
    font-size: 13px;
  }

  .section-title span:last-child {
    color: #7CB1D2;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .category {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 24px;
    color: #35495E;
    text-decoration: none;
    border: 1px solid #CFE3EF;
    border-radius: 14px;
    background: #FFFFFF;
    box-shadow: 0 4px 14px rgba(124, 177, 210, 0.06);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .category:hover {
    color: #35495E;
    transform: translateY(-5px);
    border-color: #7CB1D2;
    box-shadow: 0 10px 24px rgba(124, 177, 210, 0.12);
  }

  .category-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid #E5F0F4;
    font-family: monospace;
    font-size: 12px;
    color: #849A98;
  }

  .category-top span:last-child {
    color: #7CB1D2;
    font-size: 18px;
  }

  .category-main {
    flex: 1;
    padding: 30px 0;
  }

  .category-main h2 {
    margin: 0 0 12px;
    color: #35495E;
    font-size: 32px;
    line-height: 1.4;
    font-weight: 500;
  }

  .category-main p {
    margin: 0;
    color: #849A98;
    font-size: 13px;
    line-height: 1.8;
  }

  .category-count {
    padding-top: 14px;
    border-top: 1px solid #E5F0F4;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #7CB1D2;
  }

  /* 底部 */

  footer {
    display: flex;
    justify-content: space-between;

    margin-top: 100px;
    padding-top: 20px;

    border-top: 1px solid #35495E;

    font-family: monospace;
    font-size: 12px;

    color: #849A98;
  }

  /* 手机 */

  @media (max-width: 700px) {

    .latest-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .latest-post {
      min-height: 220px;
    }

    .page {
      padding: 30px 20px;
    }

    header {
      align-items: flex-start;
    }

    nav {
      gap: 15px;
    }

    .intro {
      padding: 80px 0 90px;
    }

    .category-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .category {
      min-height: 220px;
    }

    .category-main h2 {
      font-size: 28px;
    }

    .category-main p {
      font-size: 13px;
      line-height: 1.7;
    }

    footer {
      display: block;
      line-height: 2;
    }
  }
</style>
